# 복사해서 .env 로 저장한 뒤 값을 채우세요:  cp .env.example .env  (윈도우: copy .env.example .env)

# ── 대본 생성 ─────────────────────────────────────────────
# auto | claude | openai | ollama | template
#   auto: 아래 키가 있는 순서(Claude → OpenAI → Ollama)로 고르고, 없으면 template(키 없이 돌아가는 예시 대본)
SCRIPT_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 내 PC 의 Ollama (무료, 로컬)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ── 음성 합성 ─────────────────────────────────────────────
# edge | elevenlabs | dummy(무음, 오프라인 테스트용)
TTS_ENGINE=edge
EDGE_VOICE=ko-KR-SunHiNeural      # 남성: ko-KR-InJoonNeural / ko-KR-HyunsuMultilingualNeural
EDGE_RATE=+10%
EDGE_PROXY=                        # 필요할 때만, 예: http://127.0.0.1:8080
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── 영상 ─────────────────────────────────────────────────
# 비워 두면 운영체제 기본 한글 폰트(맑은 고딕, Apple SD 고딕, Noto CJK)를 자동으로 찾음
FONT_PATH=
BGM_VOLUME=0.30         # 말이 없을 때 BGM 크기 (0~1)
BGM_DUCK_VOLUME=0.08    # 말할 때 BGM 크기 (오디오 덕킹)

# ── 유튜브 업로드 ─────────────────────────────────────────
# Google Cloud 콘솔에서 받은 OAuth 클라이언트(데스크톱 앱) JSON
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
